-
-    <device-padding
-        launcher:maxEmptySpace="100dp">
-        <workspaceTopPadding
-            launcher:a="0.31"
-            launcher:b="0"/>
-        <workspaceBottomPadding
-            launcher:a="0.69"
-            launcher:b="0"/>
-        <hotseatBottomPadding
-            launcher:a="0"
-            launcher:b="0"/>
