From 515b47003a6c65d5a727a1016c2f9b0611731216 Mon Sep 17 00:00:00 2001
From: Abhay Singh Gill <abhaygill017@gmail.com>
Date: Sun, 5 Jan 2025 17:41:25 +0530
Subject: [PATCH 4/4] Launcher3: Ditch workspace top/bottom padding for 6*5
 grid

Limits workspace grid area.

Signed-off-by: Abhay Singh Gill <abhaygill017@gmail.com>
---
 res/xml/device_profiles.xml |  1 -
 res/xml/paddings_6x5.xml    | 45 -------------------------------------
 2 files changed, 46 deletions(-)
 delete mode 100644 res/xml/paddings_6x5.xml

diff --git a/res/xml/device_profiles.xml b/res/xml/device_profiles.xml
index aece22cbb7..8f91d7a884 100644
--- a/res/xml/device_profiles.xml
+++ b/res/xml/device_profiles.xml
@@ -253,7 +253,6 @@
         launcher:dbFile="launcher_6_by_5.db"
         launcher:defaultLayoutId="@xml/default_workspace_6x5"
         launcher:deviceCategory="tablet"
-        launcher:devicePaddingId="@xml/paddings_6x5"
         launcher:folderStyle="@style/Folder6x5Style"
         launcher:inlineNavButtonsEndSpacing="@dimen/taskbar_button_margin_6_5"
         launcher:inlineQsb="landscape"
diff --git a/res/xml/paddings_6x5.xml b/res/xml/paddings_6x5.xml
deleted file mode 100644
index 2f421b78e3..0000000000
--- a/res/xml/paddings_6x5.xml
+++ /dev/null
@@ -1,45 +0,0 @@
