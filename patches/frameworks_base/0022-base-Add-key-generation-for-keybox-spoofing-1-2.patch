-                ? provider.getEcCertificateChain()
-                : provider.getRsaCertificateChain();
-
-        ByteArrayOutputStream certificateStream = new ByteArrayOutputStream();
-        for (String cert : certChain) {
-            certificateStream.write(parseCertificate(cert));
