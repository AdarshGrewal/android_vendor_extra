From fd445aab1d07a1853b1151e7aa7c312226e69265 Mon Sep 17 00:00:00 2001
From: Abhay Singh Gill <abhaygill017@gmail.com>
Date: Tue, 16 Sep 2025 15:06:21 +0530
Subject: [PATCH 25/30] PropImitationHooks: Block key attestation for play
 integrity

Change-Id: I3d9f9e04fc08c5b212309263aae55296bb98920f
Signed-off-by: Abhay Singh Gill <abhaygill017@gmail.com>
---
 .../android/internal/util/PropImitationHooks.java  | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/core/java/com/android/internal/util/PropImitationHooks.java b/core/java/com/android/internal/util/PropImitationHooks.java
index 5def07d3d251..5d269e9b5e01 100644
--- a/core/java/com/android/internal/util/PropImitationHooks.java
+++ b/core/java/com/android/internal/util/PropImitationHooks.java
@@ -36,6 +36,7 @@ import com.android.internal.util.extra.KeyProviderManager;
 
 import java.lang.reflect.Field;
 import java.util.Arrays;
+import java.util.Locale;
 import java.util.Map;
 import java.util.Set;
 
@@ -254,9 +255,10 @@ public class PropImitationHooks {
         return gmsUid == callingUid;
     }
 
-    private static boolean isCallerSafetyNet() {
-        return sIsGms && Arrays.stream(Thread.currentThread().getStackTrace())
-                .anyMatch(elem -> elem.getClassName().contains("DroidGuard"));
+    private static boolean isCallerPlayIntegrity() {
+        return Arrays.stream(Thread.currentThread().getStackTrace())
+                .map(StackTraceElement::getClassName)
+                .anyMatch(name -> name.toLowerCase(Locale.US).contains("droidguard"));
     }
 
     public static void onEngineGetCertificateChain() {
@@ -271,9 +273,9 @@ public class PropImitationHooks {
             return;
         }
 
-        // Check stack for SafetyNet or Play Integrity
-        if (isCallerSafetyNet() || sIsFinsky) {
-            dlog("Blocked key attestation sIsGms=" + sIsGms + " sIsFinsky=" + sIsFinsky);
+        // Check stack for Play Integrity
+        if (isCallerPlayIntegrity()) {
+            dlog("Blocked key attestation for play integrity");
             throw new UnsupportedOperationException();
         }
     }
-- 
