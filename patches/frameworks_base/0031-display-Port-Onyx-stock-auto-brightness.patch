+        private Pair<float[], float[]> getOnyxAdjustedCurve(float[] lux, float[] brightness) {
+            // Keep stock gamma processing, but insert the user point through Xiaomi Global's
+            // smoother rather than the generic permissible-ratio clamps.
+            Pair<float[], float[]> curve = getAdjustedCurve(lux, brightness, INVALID_LUX,
+                    PowerManager.BRIGHTNESS_INVALID_FLOAT, mAutoBrightnessAdjustment, mMaxGamma);
+            return mUserLux == INVALID_LUX ? curve : insertOnyxUserPoint(curve.first,
+                    curve.second, mUserLux, mUserBrightness, mUserUnadjustedBrightness);
+        }
+
+        private static Pair<float[], float[]> insertOnyxUserPoint(float[] lux, float[] brightness,
+                float userLux, float userBrightness, float unadjustedBrightness) {
+            int idx = 0;
+            while (idx < lux.length && lux[idx] < userLux) {
+                idx++;
+            }
+            float[] newLux;
+            float[] newBrightness;
+            if (idx < lux.length && lux[idx] == userLux) {
+                newLux = Arrays.copyOf(lux, lux.length);
+                newBrightness = Arrays.copyOf(brightness, brightness.length);
+            } else {
+                newLux = new float[lux.length + 1];
+                newBrightness = new float[brightness.length + 1];
+                System.arraycopy(lux, 0, newLux, 0, idx);
+                System.arraycopy(brightness, 0, newBrightness, 0, idx);
+                System.arraycopy(lux, idx, newLux, idx + 1, lux.length - idx);
+                System.arraycopy(brightness, idx, newBrightness, idx + 1,
+                        brightness.length - idx);
+            }
+            newLux[idx] = userLux;
+            newBrightness[idx] = userBrightness;
+
+            // Verified against Xiaomi Global BrightnessMappingStrategyImpl.smoothNewCurve.
+            // Preserve the shipped float operation order, not just its algebraic equivalent.
+            for (int i = idx + 1; i < newLux.length; i++) {
+                newBrightness[i] = newBrightness[i]
+                        - (unadjustedBrightness - newBrightness[idx]);
+                newBrightness[i] = MathUtils.max(newBrightness[i], newBrightness[i - 1]);
+            }
+            for (int i = idx - 1; i >= 0; i--) {
+                newBrightness[i] = newBrightness[i]
+                        - (((unadjustedBrightness - newBrightness[idx]) * newBrightness[i])
+                                / unadjustedBrightness);
+                newBrightness[i] = MathUtils.min(newBrightness[i], newBrightness[i + 1]);
+            }
+            return Pair.create(newLux, newBrightness);
+        }
+
         private float getUnadjustedBrightness(float lux) {
