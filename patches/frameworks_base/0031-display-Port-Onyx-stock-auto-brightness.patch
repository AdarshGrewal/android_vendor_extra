+package com.android.server.display;
+
+import android.content.Context;
+import android.graphics.Rect;
+import android.hardware.Sensor;
+import android.hardware.SensorEvent;
+import android.hardware.SensorEventListener;
+import android.hardware.SensorManager;
+import android.hardware.camera2.CameraAccessException;
+import android.hardware.camera2.CameraCharacteristics;
+import android.hardware.camera2.CameraManager;
+import android.hardware.display.DisplayManager;
+import android.hardware.input.InputManager;
+import android.os.Handler;
+import android.util.Slog;
+import android.view.Display;
+import android.view.DisplayInfo;
+import android.view.InputEvent;
+import android.view.InputEventReceiver;
+import android.view.InputMonitor;
+import android.view.MotionEvent;
+import android.view.Surface;
+
+import java.io.PrintWriter;
+import java.util.HashMap;
+import java.util.Map;
+import java.util.concurrent.TimeUnit;
+
+/** Platform integration for {@link OnyxLuxPolicy}, confined to the ABC's handler. */
+final class OnyxBrightnessSensorPolicy {
+    private static final String TAG = "OnyxBrightnessSensorPolicy";
+    private static final int ASSIST_SENSOR_TYPE = 33171055;
+    private static final int POCKET_SENSOR_TYPE = 33171027;
+    private static final String[] CAMERA_ROLE_TAGS = {
+            "com.xiaomi.cameraid.role.cameraIds", "com.xiaomi.cameraid.role.cameraId"};
+
+    static final class Config {
+        final boolean enabled;
+        final OnyxLuxPolicy.Thresholds thresholds;
+        final long smallDebounce;
+        final Rect touchRect;
+        final long touchDebounce;
+        final long initialFastWindow;
+        final long pocketFastWindow;
+        final long torchCooldown;
+
+        Config(boolean enabled, OnyxLuxPolicy.Thresholds thresholds, long smallDebounce,
+                int[] touchRect, long touchDebounce, long initialFastWindow,
+                long pocketFastWindow, long torchCooldown) {
+            if (touchRect == null || touchRect.length != 4 || touchDebounce < 0
+                    || initialFastWindow < 0 || pocketFastWindow < 0 || torchCooldown < 0) {
+                throw new IllegalArgumentException("Invalid Onyx protection configuration");
+            }
+            this.enabled = enabled;
+            this.thresholds = thresholds;
+            this.smallDebounce = smallDebounce;
+            this.touchRect = new Rect(touchRect[0], touchRect[1], touchRect[2], touchRect[3]);
+            this.touchDebounce = touchDebounce;
+            this.initialFastWindow = initialFastWindow;
+            this.pocketFastWindow = pocketFastWindow;
+            this.torchCooldown = torchCooldown;
+        }
+
+        static Config stock(boolean enabled, float hbmMinimumLux) {
+            return new Config(enabled, OnyxLuxPolicy.Thresholds.stock(hbmMinimumLux), 5000,
+                    new int[] {0, 0, 1440, 750}, 1000, 3000, 2000, 1800);
+        }
+    }
+
+    private final Context mContext;
+    private final SensorManager mSensorManager;
+    private final Handler mHandler;
+    private final AutomaticBrightnessController.Clock mClock;
+    private final Config mConfig;
+    private final OnyxLuxPolicy mPolicy;
+    private final OnyxLuxPolicy.FastRateState mFastRateState = new OnyxLuxPolicy.FastRateState();
+    private final Sensor mAssistSensor;
+    private final Sensor mPocketSensor;
+    private final CameraManager mCameraManager;
+    private final DisplayManager mDisplayManager;
+    private final int mRate;
+    private final Map<String, Boolean> mTorchStates = new HashMap<>();
+    private final Map<String, Boolean> mExcludedTorchCameras = new HashMap<>();
+    private final OnyxLuxPolicy.SampleTime mMainSampleTime = new OnyxLuxPolicy.SampleTime();
+    private final OnyxLuxPolicy.SampleTime mAssistSampleTime = new OnyxLuxPolicy.SampleTime();
+    private boolean mEnabled;
+    private boolean mAssistRegistered;
+    private boolean mPocketRegistered;
+    private boolean mTorchRegistered;
+    private boolean mStopped;
+    private float mPocketValue;
+    private long mFastChangeUntil = Long.MIN_VALUE;
+    private InputMonitor mInputMonitor;
+    private InputEventReceiver mInputReceiver;
+    private final Rect mTouchRect = new Rect();
+
+    OnyxBrightnessSensorPolicy(Context context, SensorManager sensorManager, Handler handler,
+            AutomaticBrightnessController.Clock clock, Config config,
+            OnyxLuxPolicy.Listener listener, int longHorizon, int shortHorizon, int warmUp,
+            int rate, long brightDebounce, long darkDebounce) {
+        mContext = context;
+        mSensorManager = sensorManager;
+        mHandler = handler;
+        mClock = clock;
+        mConfig = config;
+        mRate = rate;
+        mPolicy = new OnyxLuxPolicy(config.thresholds, (lux, fast, slow, fastChange) -> {
+            if (fastChange) mFastChangeUntil = now() + 2000;
+            mFastRateState.ambientUpdated(now());
+            listener.onAmbientLux(lux, fast, slow, fastChange);
+        }, longHorizon, shortHorizon, warmUp, rate, brightDebounce, darkDebounce,
+                config.smallDebounce, config.initialFastWindow, config.pocketFastWindow,
+                config.torchCooldown);
+        mAssistSensor = sensorManager.getDefaultSensor(ASSIST_SENSOR_TYPE);
+        Sensor pocketSensor = sensorManager.getDefaultSensor(POCKET_SENSOR_TYPE);
+        mPocketSensor = pocketSensor != null ? pocketSensor
+                : sensorManager.getDefaultSensor(POCKET_SENSOR_TYPE, true);
+        mCameraManager = context.getSystemService(CameraManager.class);
+        mDisplayManager = context.getSystemService(DisplayManager.class);
+        findExcludedTorchCameras();
+        if (mCameraManager != null) {
+            mCameraManager.registerTorchCallback(mTorchCallback, mHandler);
+            mTorchRegistered = true;
+        }
+    }
+
+    void setEnabled(boolean enabled) {
+        setEnabled(enabled, false);
+    }
+
+    void setEnabled(boolean enabled, boolean firstAutoBrightness) {
+        if (mStopped && enabled) return;
+        if (enabled == mEnabled) return;
+        mEnabled = enabled;
+        mPolicy.setEnabled(enabled, now());
+        mFastChangeUntil = Long.MIN_VALUE;
+        mFastRateState.reset(enabled && firstAutoBrightness);
+        mPocketValue = 0;
+        if (enabled) {
+            if (mAssistSensor != null) {
+                mAssistSampleTime.registered(now(),
+                        mAssistSensor.getReportingMode() == Sensor.REPORTING_MODE_ON_CHANGE);
+                mAssistRegistered = mSensorManager.registerListener(mAssistListener, mAssistSensor,
+                        mRate * 1000, mHandler);
+            }
+            if (mPocketSensor != null) {
+                mPocketRegistered = mSensorManager.registerListener(mPocketListener, mPocketSensor,
+                        SensorManager.SENSOR_DELAY_NORMAL, mHandler);
+            }
+            startTouchTracking();
+        } else {
+            mMainSampleTime.clear();
+            mAssistSampleTime.clear();
+            mHandler.removeCallbacks(mUpdate);
+            if (mAssistRegistered) mSensorManager.unregisterListener(mAssistListener);
+            if (mPocketRegistered) mSensorManager.unregisterListener(mPocketListener);
+            mAssistRegistered = false;
+            mPocketRegistered = false;
+            if (mInputReceiver != null) mInputReceiver.dispose();
+            if (mInputMonitor != null) mInputMonitor.dispose();
+            mInputReceiver = null;
+            mInputMonitor = null;
+        }
+    }
+
+    void stop() {
+        setEnabled(false);
+        if (mTorchRegistered) mCameraManager.unregisterTorchCallback(mTorchCallback);
+        mTorchRegistered = false;
+        mStopped = true;
+    }
+
+    boolean onMainLight(long time, float lux) {
+        boolean accepted = mPolicy.add(OnyxLuxPolicy.MAIN, time, lux, now());
+        scheduleUpdate();
+        return accepted;
+    }
+
+    void mainLightSensorRegistered(Sensor sensor) {
+        mMainSampleTime.registered(now(),
+                sensor.getReportingMode() == Sensor.REPORTING_MODE_ON_CHANGE);
+    }
+
+    long mainLightSampleTime(long time, float lux) {
+        return mEnabled ? mMainSampleTime.normalize(time, lux, now())
+                : OnyxLuxPolicy.SampleTime.INVALID;
+    }
+
+    boolean shouldUseFastRate() {
+        return mEnabled && (now() < mFastChangeUntil || mPolicy.inFastWindow(now()));
+    }
+
+    boolean shouldUseFastRate(float currentNits, float targetNits) {
+        long time = now();
+        return mEnabled && mFastRateState.shouldUse(time, mPolicy.inFastWindow(time),
+                currentNits, targetNits);
+    }
+
+    float brighteningThreshold(float lux) { return mPolicy.brighteningThreshold(lux); }
+    float darkeningThreshold(float lux) { return mPolicy.darkeningThreshold(lux); }
+
+    private long now() { return mClock.getSensorEventScaleTime(); }
+
+    private void scheduleUpdate() {
+        mHandler.removeCallbacks(mUpdate);
+        long sensorTime = mPolicy.update(now());
+        if (sensorTime != Long.MAX_VALUE && mEnabled) {
+            mHandler.postAtTime(mUpdate, sensorTime - now() + mClock.uptimeMillis());
+        }
+    }
+
+    private final Runnable mUpdate = this::scheduleUpdate;
+
+    private final SensorEventListener mAssistListener = new SensorEventListener() {
+        @Override
+        public void onSensorChanged(SensorEvent event) {
+            if (!mEnabled || event.values.length == 0) return;
+            long now = now();
+            long time = mAssistSampleTime.normalize(
+                    TimeUnit.NANOSECONDS.toMillis(event.timestamp), event.values[0], now);
+            if (time == OnyxLuxPolicy.SampleTime.INVALID) return;
+            mPolicy.add(OnyxLuxPolicy.ASSIST, time, event.values[0], now);
+            scheduleUpdate();
+        }
+
+        @Override
+        public void onAccuracyChanged(Sensor sensor, int accuracy) { }
+    };
+
+    private final SensorEventListener mPocketListener = new SensorEventListener() {
+        @Override
+        public void onSensorChanged(SensorEvent event) {
+            if (!mEnabled || event.values.length == 0 || !Float.isFinite(event.values[0])) return;
+            if (event.values[0] != mPocketValue) {
+                mPocketValue = event.values[0];
+                if (mPocketValue == 0) mPolicy.pocketExited(now());
+            }
+        }
+
+        @Override
+        public void onAccuracyChanged(Sensor sensor, int accuracy) { }
+    };
+
+    private void findExcludedTorchCameras() {
+        if (mCameraManager == null) return;
+        try {
+            for (String id : mCameraManager.getCameraIdList()) {
+                CameraCharacteristics characteristics = mCameraManager.getCameraCharacteristics(id);
+                for (String tag : CAMERA_ROLE_TAGS) {
+                    Integer[] roles;
+                    try {
+                        roles = characteristics.get(new CameraCharacteristics.Key<>(tag,
+                                Integer[].class));
+                    } catch (IllegalArgumentException e) {
+                        continue;
+                    }
+                    if (roles == null) continue;
+                    boolean excluded = false;
+                    for (Integer role : roles) {
+                        if (role != null && (role == 100 || role == 101 || role == 102)) {
+                            excluded = true;
+                        }
+                    }
+                    mExcludedTorchCameras.put(id, excluded);
+                    break;
+                }
+            }
+        } catch (CameraAccessException | IllegalArgumentException e) {
+            Slog.w(TAG, "Unable to enumerate torch cameras", e);
+        }
+    }
+
+    private final CameraManager.TorchCallback mTorchCallback = new CameraManager.TorchCallback() {
+        @Override
+        public void onTorchModeChanged(String cameraId, boolean enabled) {
+            if (!Boolean.TRUE.equals(mExcludedTorchCameras.get(cameraId))) {
+                updateTorch(cameraId, enabled);
+            }
+        }
+
+        @Override
+        public void onTorchModeUnavailable(String cameraId) {
+            // Stock treats an unavailable rear flash as potentially contaminating the rear ALS.
+            if (!mStopped) {
+                mPolicy.setTorch(true, now());
+                scheduleUpdate();
+            }
+        }
+    };
+
+    private void updateTorch(String cameraId, boolean torch) {
+        if (mStopped) return;
+        mTorchStates.put(cameraId, torch);
+        boolean anyTorch = false;
+        for (boolean state : mTorchStates.values()) anyTorch |= state;
+        mPolicy.setTorch(anyTorch, now());
+        scheduleUpdate();
+    }
+
+    @SuppressWarnings("deprecation")
+    private void startTouchTracking() {
+        if (mConfig.touchRect.isEmpty()) return;
+        InputManager inputManager = mContext.getSystemService(InputManager.class);
+        if (inputManager == null || mDisplayManager == null) return;
+        try {
+            mInputMonitor = inputManager.monitorGestureInput(TAG, Display.DEFAULT_DISPLAY);
+            mInputReceiver = new InputEventReceiver(mInputMonitor.getInputChannel(),
+                    mHandler.getLooper()) {
+                @Override
+                public void onInputEvent(InputEvent event) {
+                    try {
+                        if (mEnabled && event instanceof MotionEvent motion
+                                && motion.isTouchEvent()) onTouch(motion);
+                    } finally {
+                        finishInputEvent(event, false);
+                    }
+                }
+            };
+        } catch (RuntimeException e) {
+            Slog.w(TAG, "Unable to monitor ALS cover touches", e);
+            if (mInputMonitor != null) mInputMonitor.dispose();
+            mInputMonitor = null;
+        }
+    }
+
+    private void onTouch(MotionEvent event) {
+        updateTouchRect();
+        boolean touching = false;
+        int action = event.getActionMasked();
+        if (action != MotionEvent.ACTION_UP && action != MotionEvent.ACTION_CANCEL) {
+            for (int i = 0; i < event.getPointerCount(); i++) {
+                if (action == MotionEvent.ACTION_POINTER_UP && i == event.getActionIndex()) continue;
+                if (mTouchRect.contains(Math.round(event.getX(i)), Math.round(event.getY(i)))) {
+                    touching = true;
+                    break;
+                }
+            }
+        }
+        mPolicy.setTouch(touching, now(), mConfig.touchDebounce);
+        scheduleUpdate();
+    }
+
+    private void updateTouchRect() {
+        mTouchRect.setEmpty();
+        Display display = mDisplayManager.getDisplay(Display.DEFAULT_DISPLAY);
+        if (display == null) return;
+        DisplayInfo info = new DisplayInfo();
+        if (!display.getDisplayInfo(info)) return;
+        // The stock rectangle is in native panel pixels and protects only landscape rotations.
+        int physicalWidth = display.getMode().getPhysicalWidth();
+        int physicalHeight = display.getMode().getPhysicalHeight();
+        Rect border = mConfig.touchRect;
+        if (info.rotation == Surface.ROTATION_90) {
+            mTouchRect.set(border.top, physicalWidth - border.right, border.bottom,
+                    physicalWidth - border.left);
+        } else if (info.rotation == Surface.ROTATION_270) {
+            mTouchRect.set(physicalHeight - border.bottom, border.left,
+                    physicalHeight - border.top, border.right);
+        } else {
+            return;
+        }
+        mTouchRect.scale((float) info.logicalHeight / physicalWidth);
+    }
+
+    void dump(PrintWriter writer) {
+        writer.println("  Onyx sensors: assist=" + mAssistSensor + ", pocket=" + mPocketSensor
+                + ", assistRegistered=" + mAssistRegistered + ", pocketRegistered="
+                + mPocketRegistered + ", touchMonitoring=" + (mInputMonitor != null));
+        mPolicy.dump(writer);
+    }
+}
