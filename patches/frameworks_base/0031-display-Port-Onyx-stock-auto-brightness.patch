+        mEnabled = enabled;
+        mEnableTime = now;
+        mSource = NONE;
+        mAmbientLux = -1;
+        mPocketExit = Long.MIN_VALUE;
+        mTouchUntil = Long.MIN_VALUE;
+        mTouch = false;
+        for (int i = MAIN; i <= ASSIST; i++) {
+            invalidate(i);
+        }
+    }
